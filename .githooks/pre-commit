#!/bin/sh
# Blocks commits that contain secrets. This repo is PUBLIC — bots scrape
# GitHub for Telegram tokens within minutes, so a leaked token = hacked bot.
# Enable once per clone:  git config core.hooksPath .githooks

fail=0

# 1. No .env files (only .env.example is allowed)
envfiles=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env' | grep -v '\.env\.example$')
if [ -n "$envfiles" ]; then
  echo "BLOCKED: .env files must never be committed:"
  echo "$envfiles" | sed 's/^/  /'
  fail=1
fi

# 2. No secret values in added lines
patterns='[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}|private_[A-Za-z0-9+/=]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
hits=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+[^+]' | grep -oE "$patterns" | sed -E 's/^(.{12}).*/\1…/')
if [ -n "$hits" ]; then
  echo "BLOCKED: staged changes contain what looks like a secret (Telegram token / private key):"
  echo "$hits" | sed 's/^/  /'
  fail=1
fi

if [ $fail -ne 0 ]; then
  echo "Put secrets in Vercel env vars or a local .env (git-ignored) instead."
  exit 1
fi
